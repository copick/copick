 "additionalProperties": false,
 "description": "A projection image that belongs to a tilt series.",
 "properties": {
  "accumulated_dose": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "The pre-exposure up to this image in e-/A^2",
   "title": "Accumulated Dose"
  },
  "acquisition_order": {
   "anyOf": [
    {
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "Index giving the temporal order in which this tilt image was acquired during tilt-series collection (i.e. the dose-accumulation / tilt-scheme order), independent of its section index or nominal tilt angle within the stack.",
   "title": "Acquisition Order"
  },
  "coordinate_systems": {
   "anyOf": [
    {
     "items": {
      "$ref": "#/$defs/CoordinateSystem"
     },
     "type": "array"
    },
    {
     "type": "null"
    }
   ],
   "default": [],
   "description": "Named coordinate systems for this entity",
   "title": "Coordinate Systems"
  },
  "coordinate_transformations": {
   "anyOf": [
    {
     "items": {
      "discriminator": {
       "mapping": {
        "affine": "#/$defs/Affine",
        "identity": "#/$defs/Identity",
        "map_axis": "#/$defs/MapAxis",
        "project_axis": "#/$defs/ProjectAxis",
        "reflection": "#/$defs/Reflection",
        "rot90": "#/$defs/Rot90",
        "scale": "#/$defs/Scale",
        "sequence": "#/$defs/Sequence",
        "translation": "#/$defs/Translation"
       },
       "propertyName": "transformation_type"
      },
      "oneOf": [
       {
        "$ref": "#/$defs/Identity"
       },
       {
        "$ref": "#/$defs/MapAxis"
       },
       {
        "$ref": "#/$defs/Translation"
       },
       {
        "$ref": "#/$defs/Scale"
       },
       {
        "$ref": "#/$defs/Affine"
       },
       {
        "$ref": "#/$defs/Rot90"
       },
       {
        "$ref": "#/$defs/Reflection"
       },
       {
        "$ref": "#/$defs/ProjectAxis"
       },
       {
        "$ref": "#/$defs/Sequence"
       }
      ]
     },
     "type": "array"
    },
    {
     "type": "null"
    }
   ],
   "default": [],
   "description": "Named coordinate transformations for this image. The transformation named array_to_physical is the image frame. It maps the coordinate system named array (axes x, y and z by position, of type array, in pixel) to the one named physical (of type space, in angstrom). It is a Sequence of an optional Rot90, an optional Reflection, a Translation and a Scale, in that order and each at most once, so that physical = diag(scale) (F R index + translation). The translation is in pixels along the oriented axes, and the scale is the pixel or voxel spacing in angstrom along the final axes. A missing step means no rotation, no reflection, zero translation or unit spacing. Other named transformations are not restricted.",
   "title": "Coordinate Transformations"
  },
  "ctf_metadata": {
   "anyOf": [
    {
     "$ref": "#/$defs/CTFMetadata"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "A set of CTF patameters for an image."
  },
  "exposure_time": {
